# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НИКОГДА не коммитьте в GitHub (он уже в .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=123456789

# MongoDB (локальная установка)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=support_bot

# Часовой пояс для отображения дат
TIMEZONE=Europe/Moscow

# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
